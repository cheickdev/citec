# Variables a mettre dans Vercel (Settings -> Environment Variables)
DATABASE_URL=postgresql://...        # lien de la base Neon
SESSION_SECRET=une-longue-phrase-secrete
ADMIN_PHONE=70000000                 # telephone du patron (admin.citec.app)
ADMIN_PASSWORD=au-moins-8-caracteres
ADMIN_NAME=Patron
BLOB_READ_WRITE_TOKEN=               # cree par le Blob store (documents)
